table MonthlyMetrics
	lineageTag: 5a25f6e5-07d1-4684-b7eb-7544a9edd02c

	measure 'Total Revenue USD' = SUM(MonthlyMetrics[total_revenue_usd])
		formatString: \$#,##0.00
		lineageTag: e2b8957f-33e9-470a-b489-85788057ad12

	measure 'Total Transaction Volume USD' = SUM(MonthlyMetrics[transaction_volume_usd])
		formatString: \$#,##0.00
		lineageTag: 5e46d3a3-84a4-44bf-922f-34bdc678011c

	measure 'Total Transactions' = SUM(MonthlyMetrics[transaction_count])
		formatString: #,##0
		lineageTag: 686fe549-1b82-4523-82cd-a5166e95057b

	measure 'Monthly Active Users' = CALCULATE(DISTINCTCOUNT(MonthlyMetrics[customer_id]), MonthlyMetrics[is_active] = 1)
		formatString: #,##0
		lineageTag: 817b95e8-84b8-4db0-b6b2-0f33d01f20bd

	measure 'Revenue per Active User' = DIVIDE([Total Revenue USD], [Monthly Active Users], 0)
		formatString: \$#,##0.00
		lineageTag: 7ad1b878-dd6a-4b2a-a9e3-d796390e37b7

	measure 'Previous Month Revenue USD' = ```
			VAR ThisMonth = MAX(MonthlyMetrics[month_start])
			VAR PrevMonth = EDATE(ThisMonth, -1)
			RETURN CALCULATE([Total Revenue USD], REMOVEFILTERS(MonthlyMetrics[month_start]), MonthlyMetrics[month_start] = PrevMonth)
			
			```
		lineageTag: 75116c34-5656-4c77-b71e-52569ceecc55

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MoM Revenue Growth' = DIVIDE([Total Revenue USD] - [Previous Month Revenue USD], [Previous Month Revenue USD], 0)
		formatString: 0.0%
		lineageTag: bd20ba34-5125-44d6-af11-8bf9fb22ccf9

	measure 'Previous Month Active Base' = ```
			VAR ThisMonth = MAX(MonthlyMetrics[month_start])
			VAR PrevMonth = EDATE(ThisMonth, -1)
			RETURN CALCULATE(DISTINCTCOUNT(MonthlyMetrics[customer_id]), REMOVEFILTERS(MonthlyMetrics[month_start]), MonthlyMetrics[month_start] = PrevMonth, MonthlyMetrics[is_active] = 1)
			
			```
		formatString: 0
		lineageTag: 21c015cf-0975-487f-92e1-28c231281e84

	measure 'Churned Customers' = ```
			VAR ThisMonth = MAX(MonthlyMetrics[month_start])
			VAR PrevMonth = EDATE(ThisMonth, -1)
			RETURN SUMX(VALUES(Customers[customer_id]),
			  VAR PriorActive = CALCULATE(MAX(MonthlyMetrics[is_active]), REMOVEFILTERS(MonthlyMetrics[month_start]), MonthlyMetrics[month_start] = PrevMonth)
			  VAR CurrentActive = CALCULATE(MAX(MonthlyMetrics[is_active]), REMOVEFILTERS(MonthlyMetrics[month_start]), MonthlyMetrics[month_start] = ThisMonth)
			  RETURN IF(PriorActive = 1 && CurrentActive = 0, 1, 0))
			
			```
		formatString: 0
		lineageTag: 89b31e4e-c1bf-4197-bea0-d557c0775d8a

	measure 'Churn Proxy Rate' = DIVIDE([Churned Customers], [Previous Month Active Base], 0)
		formatString: 0.0%
		lineageTag: c9232c99-70f3-47ca-942c-ad2cc3b2ed7a

	measure 'Retention Rate' = 1 - [Churn Proxy Rate]
		formatString: 0.0%
		lineageTag: f645cb33-fb38-4d1d-90d4-d41684ebf598

	measure 'Plan Revenue Rank' = RANKX(ALL(Customers[plan]), [Total Revenue USD],, DESC, DENSE)
		formatString: 0
		lineageTag: 3e043037-22e8-4297-8459-c63533fa2d94

	column customer_id
		dataType: int64
		lineageTag: 4dd90aed-2c95-4670-95b9-a73a72d9075d
		summarizeBy: none
		sourceColumn: customer_id

	column month_start
		dataType: dateTime
		formatString: Long Date
		lineageTag: ba023d25-9d37-4733-9f78-74d892b90a46
		summarizeBy: none
		sourceColumn: month_start

		variation Variation
			isDefault
			relationship: dad6a29c-8ef7-4b8c-a864-6eeaec17237f
			defaultHierarchy: LocalDateTable_3f33b6f5-211f-42da-9be9-d5411cd3e602.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column is_active
		dataType: int64
		lineageTag: 25523b3c-af76-48ec-bcbb-907f176ef686
		summarizeBy: sum
		sourceColumn: is_active

		annotation SummarizationSetBy = Automatic

	column transaction_count
		dataType: int64
		lineageTag: 82a06235-69b9-4fbd-9235-1420f0ae8208
		summarizeBy: sum
		sourceColumn: transaction_count

		annotation SummarizationSetBy = Automatic

	column transaction_volume_usd
		dataType: double
		lineageTag: a4423ff8-9a24-41a7-96df-af3ffac6a3dc
		summarizeBy: sum
		sourceColumn: transaction_volume_usd

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column subscription_revenue_usd
		dataType: double
		lineageTag: 800f8cd4-ccef-4b10-9d5d-4592a3843c62
		summarizeBy: sum
		sourceColumn: subscription_revenue_usd

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column interchange_revenue_usd
		dataType: double
		lineageTag: 12016993-b69f-41d1-b829-6416b0eb7e7e
		summarizeBy: sum
		sourceColumn: interchange_revenue_usd

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column fx_fee_revenue_usd
		dataType: double
		lineageTag: a35b8129-2a6b-4851-b4e2-0d9f2ac961ee
		summarizeBy: sum
		sourceColumn: fx_fee_revenue_usd

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column total_revenue_usd
		dataType: double
		lineageTag: 0b62f0af-60d5-421b-bfb2-a57fa6e5929f
		summarizeBy: sum
		sourceColumn: total_revenue_usd

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column month_label
		dataType: string
		lineageTag: f9cc12f8-df2e-4a79-bfac-51fdb60e732e
		summarizeBy: none
		sourceColumn: month_label

	partition MonthlyMetrics = m
		mode: import
		source =
				let
					Encoded = "",
					Raw = Csv.Document(Binary.FromText(Encoded, BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"customer_id",Int64.Type},{"month_start",type date},{"is_active",Int64.Type},{"transaction_count",Int64.Type},{"transaction_volume_usd",type number},{"subscription_revenue_usd",type number},{"interchange_revenue_usd",type number},{"fx_fee_revenue_usd",type number},{"total_revenue_usd",type number}}),
					WithMonth = Table.AddColumn(Typed, "month_label", each Date.ToText([month_start], "yyyy-MM"), type text)
				in WithMonth

